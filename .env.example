# Copy to .env.local and fill in real values. Never commit .env.local.
# Only NEXT_PUBLIC_ variables reach the browser. Never give a secret that prefix.

# --- Site (optional) ---
# Base URL for functional links: API routes (PDF, order emails), payment
# callback and post-checkout redirects. Defaults to https://www.tillwright.app
# when unset (see src/utils/siteUrl.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required, auth + database) ---
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only service role key: checkout, payment verification, order
# status changes and `npm run seed` use it.
# Project Settings > API Keys > secret key (sb_secret_...).
# It bypasses row-level security, so it must never get a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# --- Razorpay (required for online payments, server only) ---
# Account & Settings > API Keys. Use test keys until KYC is complete.
# Used by checkout (src/app/account/checkout/actions.ts) and /api/verify.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# --- Resend (required for emails, server only) ---
# Order emails, sent from src/utils/orders/notifications.ts. The from-address
# and admin recipient are set in src/utils/siteConfig.ts, not here.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- WhatsApp Cloud API (required for WhatsApp messages, server only) ---
# Messages endpoint, e.g. https://graph.facebook.com/v20.0/<PHONE_NUMBER_ID>/messages
WHATSAPP_URL=https://graph.facebook.com/v20.0/your-phone-number-id/messages
WHATSAPP_TOKEN=your-whatsapp-access-token

# --- PDF invoices in local development (optional, server only) ---
# /api/pdf downloads a Linux-only Chromium, which can't run on Windows or
# macOS. Point this at an installed Chrome for local work. Leave it unset on
# Vercel. Examples:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_EXECUTABLE_PATH=

# --- Google Analytics (optional) ---
# Read on the server and written into the page HTML, so it is visible to
# visitors. Measurement IDs are not secret.
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Demo data seed (development only, never on production) ---
# Optional: lets the seed create the tables from supabase/schema.sql.
# Dashboard > Connect > Session pooler (works on IPv4). Contains the database
# password, so keep it out of git like everything else in .env.local.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# The seed refuses to run unless this is exactly "true".
SEED_ALLOW=false
# Passwords for the demo logins. Pick your own; they are never committed.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
